# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# electron-builder DMG output (build artifact, not source)
release

# SwiftPM scratch path for the native package's warning gate + test run. Lives at the
# REPO ROOT because CI passes `--scratch-path .swift-gate-build` from here, which is
# outside native/SoloLedger/.gitignore's reach (that one covers .build/ inside the
# package). Nothing tracks it and nothing reads it from git — check-swift-warnings.mjs
# rmSync's it before every build and hands the same path to `swift test` afterwards.
.swift-gate-build/

# Playwright E2E artifacts (screenshots + report)
test-results
playwright-report
.playwright

# UI-audit run output (timestamped report.md + summary.json + screenshots)
artifacts
.env
.env.production
.env.local

# 签名/公证凭证兜底：证书放钥匙串、.p8 放安全位置，绝不入库（防误放仓库目录）
*.p12
*.p8

# MAS provisioning profile 兜底：build/embedded.provisionprofile 本地放置，绝不入库
*.provisionprofile
*.mobileprovision

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
